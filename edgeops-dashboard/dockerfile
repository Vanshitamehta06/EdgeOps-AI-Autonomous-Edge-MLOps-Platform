# Use a lightweight Node image
FROM node:20-alpine

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the React code
COPY . .

# Expose the standard Vite development port
EXPOSE 5173

# Start the Vite app and expose it to the Docker network
CMD ["npm", "run", "dev", "--", "--host"]